# Copy to /etc/personalvpn/gateway-agent.env on a disposable Linux gateway.
# Replace every placeholder through the secret-management system; never commit the real file.
GATEWAY_ID=00000000-0000-0000-0000-000000000000
CONTROL_API_URL=https://control.example.invalid/v1/gateway
WG_INTERFACE=wg0
AGENT_POLL_INTERVAL=5s
AGENT_TLS_CERT_FILE=/etc/personalvpn/tls/agent.crt
AGENT_TLS_KEY_FILE=/etc/personalvpn/tls/agent.key
AGENT_TLS_CA_FILE=/etc/personalvpn/tls/ca.crt
AGENT_TLS_SERVER_NAME=control.example.invalid
SNAPSHOT_VERIFY_KEY=BASE64_ED25519_PUBLIC_KEY
