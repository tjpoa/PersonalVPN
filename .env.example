# Copy to a secret manager or local environment; never commit a real .env file.
APP_ENV=development
API_LISTEN_ADDRESS=:8080
DATABASE_URL=postgres://personalvpn:CHANGE_ME@db:5432/personalvpn?sslmode=verify-full
# Optional dedicated mTLS listener for gateway agents (all three are required together).
# GATEWAY_LISTEN_ADDRESS=:8443
# GATEWAY_TLS_CERT_FILE=/run/secrets/gateway-cert.pem
# GATEWAY_TLS_KEY_FILE=/run/secrets/gateway-key.pem
# GATEWAY_TLS_CA_FILE=/run/secrets/gateway-ca.pem
